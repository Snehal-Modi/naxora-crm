# NAXORA CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual configuration.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Naxora CRM"
API_V1_PREFIX=/api/v1

# Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_secure_random_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# Example: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/naxora_crm

# CORS (JSON Array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Initial Super Admin Seed (Used by seed script for initial setup)
FIRST_SUPERUSER_EMAIL=admin@nexorastaffing.com
FIRST_SUPERUSER_PASSWORD=ChangeThisAdminPassword123!
FIRST_SUPERUSER_FIRST_NAME=Nexora
FIRST_SUPERUSER_LAST_NAME=Admin

